{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "solution-graph.schema.json",
  "title": "Mathematical solution hypergraph v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "problem",
    "canonical_notation",
    "theorems",
    "nodes",
    "edges",
    "mistakes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "problem": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "statement": {
          "$ref": "#/$defs/mathText"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": [
            "object",
            "string"
          ]
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "canonical_notation": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/mathText"
      }
    },
    "theorems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "statement": {
            "$ref": "#/$defs/mathText"
          },
          "required_hypotheses": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mathText"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "assertion"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "premise",
              "milestone",
              "goal"
            ]
          },
          "assertion": {
            "$ref": "#/$defs/mathText"
          },
          "scope": {
            "type": [
              "string",
              "object",
              "array"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "method",
          "justification"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "$ref": "#/$defs/mathText"
          },
          "uses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "obligations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/mathText"
            }
          },
          "scope": {
            "type": [
              "string",
              "object",
              "array"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "related_edges",
          "pattern",
          "defect",
          "category"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "related_edges": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "pattern": {
            "$ref": "#/$defs/mathText"
          },
          "defect": {
            "$ref": "#/$defs/mathText"
          },
          "category": {
            "enum": [
              "invalid_inference",
              "missing_justification",
              "implicit_justification",
              "misapplied_theorem",
              "missing_case",
              "unjustified_assumption",
              "notation_or_definition_error"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_\\-]*$"
    },
    "mathText": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
