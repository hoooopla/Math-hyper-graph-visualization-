{
  "version": 3,
  "description": "Copy canonical public Proof Atlas workflow into an instructor-owned repository, without website sources.",
  "files": [
    {
      "source": "templates/instructor-workspace/AGENTS.md",
      "destination": "AGENTS.md"
    },
    {
      "source": "templates/instructor-workspace/README.md",
      "destination": "README.md"
    },
    {
      "source": "templates/instructor-workspace/.gitignore",
      "destination": ".gitignore"
    },
    {
      "source": "templates/instructor-workspace/validate.yml",
      "destination": ".github/workflows/validate.yml"
    },
    {
      "source": "core/SCHEMA.md",
      "destination": "SCHEMA.md"
    },
    {
      "source": "core/schema/solution-graph.schema.json",
      "destination": "schema/solution-graph.schema.json"
    },
    {
      "source": "core/validation/validate_graphs.py",
      "destination": "scripts/validate_graphs.py"
    },
    {
      "source": "workflow/assignment-policy.md",
      "destination": "prompts/assignment-policy.md"
    },
    {
      "source": "templates/instructor-workspace/assignment-policy.template.yaml",
      "destination": "templates/assignment-policy.template.yaml"
    },
    {
      "source": "workflow/generate-solution-graph.md",
      "destination": "prompts/generate-solution-graph.md"
    },
    {
      "source": "workflow/verify-solution-graph.md",
      "destination": "prompts/verify-solution-graph.md"
    },
    {
      "source": "requirements.txt",
      "destination": "requirements.txt"
    },
    {
      "source": "examples/commuting-square-roots/graph.yaml",
      "destination": "examples/commuting-square-roots/graph.yaml"
    },
    {
      "source": "examples/commuting-square-roots/verification.md",
      "destination": "examples/commuting-square-roots/verification.md"
    }
  ]
}
